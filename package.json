{
	"name": "ho-my-ai",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-check --tsconfig ./jsconfig.json",
		"deploy": "bun run build && wrangler pages deploy .svelte-kit/cloudflare",
		"deploy:prod": "bun run build && wrangler pages deploy .svelte-kit/cloudflare --branch=main",
		"cf:dev": "wrangler pages dev .svelte-kit/cloudflare",
		"generate:icons": "bun run scripts/generate-icons.js",
		"svg-to-png": "bun run scripts/svg-to-png.js",
		"test": "playwright test",
		"test:unit": "bun test src/lib",
		"test:ui": "playwright test --ui"
	},
	"devDependencies": {
		"@capacitor/cli": "^7.4.4",
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-auto": "^6.1.0",
		"@sveltejs/adapter-cloudflare": "^7.2.4",
		"@sveltejs/kit": "^2.43.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.0",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.18",
		"@tailwindcss/vite": "^4.1.13",
		"@types/node": "^22",
		"@vite-pwa/sveltekit": "^1.0.1",
		"sharp": "^0.34.4",
		"svelte": "^5.39.5",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.1.13",
		"vite": "^7.1.7",
		"vite-plugin-pwa": "^1.1.0",
		"workbox-window": "^7.3.0"
	},
	"dependencies": {
		"@capacitor/android": "^7.4.4",
		"@capacitor/core": "^7.4.4",
		"@capacitor/ios": "^7.4.4",
		"@huggingface/transformers": "^4.2.0",
		"@mlc-ai/web-llm": "^0.2.82",
		"@orama/orama": "^3.1.18",
		"@tensorflow/tfjs-converter": "^4.22.0",
		"@tensorflow/tfjs-core": "^4.22.0",
		"dexie": "^4.2.1",
		"marked": "^17.0.5",
		"pdfjs-dist": "^6.1.200",
		"svelte-i18n": "^4.0.1",
		"svelte-material-icons": "^3.0.5",
		"wrangler": "^4.73.0"
	},
	"packageManager": "bun@1.3.13",
	"engines": {
		"node": ">=20.19.0"
	}
}
